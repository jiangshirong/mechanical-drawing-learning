  "lessons": [
    {
      "title": "先认识三个投影面",
      "text": "H 是水平面，V 是正面，W 是侧面。点的位置由到三个面的距离共同确定。",
      "feature": "A",
      "unfold": 0
    },
    {
      "title": "放置 A、B 两点",
      "text": "A 距 H/V/W 分别为 12/15/10；B 在 A 左方5、后方10、上方8。左方改变左右坐标，后方改变深度，上方改变高度。",
      "feature": "B",
      "unfold": 0
    },
    {
      "title": "沿垂直方向投影",
      "text": "从空间点向每个投影面作垂线。投影丢掉垂直于该面的坐标，因此同一个点出现三个投影。",
      "feature": "A",
      "unfold": 0
    },
    {
      "title": "展开 H、W 面",
      "text": "将 H 面绕与 V 面的交线转下，将 W 面转向右侧。空间投影变成一张图纸上的三个区域。",
      "feature": "A",
      "unfold": 1
    },
    {
      "title": "核对点的位置",
      "text": "正面投影看左右与高度；水平投影看左右与前后；侧面投影看前后与高度。A、B 的位置关系可以逐项核对。",
      "feature": "B",
      "unfold": 1
    }
