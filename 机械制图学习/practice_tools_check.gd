extends "res://points_learning_check.gd"

func right_box(a: Array,end: Array,return_to_start := false,with_zoom := false) -> void:
	var start := local_mm(a)
	var finish := local_mm(end)
	c.mouse_button(b.view,start,MOUSE_BUTTON_RIGHT,true)
	await h.wait_frames(2)
	var motion := InputEventMouseMotion.new()
	motion.position = b.view.get_global_transform_with_canvas()*finish
	motion.relative = finish-start
	motion.button_mask = MOUSE_BUTTON_MASK_RIGHT
	r.get_viewport().push_input(motion,true)
	await h.wait_frames(2)
	if with_zoom:
		await c.wheel(b.view,finish,true)
		finish = local_mm(end)
	if return_to_start:
		finish = local_mm(a)
		motion = InputEventMouseMotion.new()
		motion.position = b.view.get_global_transform_with_canvas()*finish
		motion.button_mask = MOUSE_BUTTON_MASK_RIGHT
		r.get_viewport().push_input(motion,true)
		await h.wait_frames(2)
	if not return_to_start: await snapshot("tools-marquee-preview")
	c.mouse_button(b.view,finish,MOUSE_BUTTON_RIGHT,false)
	await h.wait_frames(3)

func hover_mm(p: Array) -> void:
	var event := InputEventMouseMotion.new()
	event.position = b.view.get_global_transform_with_canvas()*local_mm(p)
	r.get_viewport().push_input(event,true)
	await h.wait_frames(3)
	b.canvas.queue_redraw()
	await RenderingServer.frame_post_draw

func run(root,flag: String) -> void:
	r = root
	h = load("res://interaction_check.gd").new()
	h.r = r
	c = load("res://canvas_check.gd").new()
	c.r = r
	c.h = h
	b = r.practice
	await h.wait_frames(25)
	check("tools_start_map",r.map_active)
	check("offscreen_no_focus",DisplayServer.window_get_position().x<0 and DisplayServer.window_get_flag(DisplayServer.WINDOW_FLAG_NO_FOCUS))
	await h.choose(0)
	await button(r.free_shell.find_child("Mode_practice",true,false))
	await h.wait_frames(5)
	if flag == "--qa-practice-tools-reopen":
		var expected: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://qa/practice-tools-expected.json"))
		check("custom_names_reopen",b.document==expected.document and b.document.points.has("自定义点") and b.document.points.has("Q''"))
		check("legacy_primes_compatible",b.valid_save({"schema_version":1,"question_id":"t01-q01","lines":[],"points":{"a′":[-10,12],"b″":[5,20]},"view":{"zoom":1,"center_mm":[0,0]}}))
		check("bad_name_rejected",not b.valid_save({"schema_version":1,"question_id":"t01-q01","lines":[],"points":{"bad\nname":[-10,12]},"view":{"zoom":1,"center_mm":[0,0]}}))
		finish("practice-tools-reopen.json")
		return
	check("editable_name_no_fixed_buttons",b.name_field is LineEdit and b.names.find_children("*","Button",true,false).is_empty())
	await hover_mm([-10,12])
	check("hover_before_first_line",b.pending==null and b.cursor==[-10.0,12.0] and b.document.lines.is_empty())
	var m: Dictionary = b.canvas.last_measure_geometry
	check("hover_coordinate_visible",m.coordinate_visible and m.point==[-10.0,12.0])
	check("perpendicular_feet",m.horizontal_foot==Canvas.at([-10,0]) and m.vertical_foot==Canvas.at([0,12]))
	check("dimension_values",m.x_mm==10 and m.y_mm==12)
	check("braces_outside_dimension",m.x_label.y<Canvas.at([-10,12]).y and m.y_label.x<Canvas.at([-10,12]).x)
	await snapshot("tools-cursor-upper-left")
	await click_mm([-10,12])
	await hover_mm([10,12.6])
	check("preview_keeps_direction_assist",b.cursor==[10.0,12.0] and b.hover==[10.0,12.0])
	await click_mm([10,12.6])
	var first_id: String = b.document.lines[0].id
	check("line_still_normal",b.document.lines[0].a==[-10.0,12.0] and b.document.lines[0].b==[10.0,12.0])
	await button(b.tools.point)
	await hover_mm([7,-8])
	check("hover_before_first_point",b.cursor==[7.0,-8.0] and b.document.points.is_empty() and b.canvas.last_measure_geometry.coordinate_visible)
	await snapshot("tools-cursor-lower-right")
	await click_mm([7,-8])
	check("empty_name_no_unnamed_point",b.document.points.is_empty() and b.name_field.has_focus())
	await type_name("P")
	await click_mm([-8,4])
	check("custom_ascii_name",b.document.points.get("P")==[-8.0,4.0])
	await type_name("Q''")
	await click_mm([6,5])
	check("ascii_primes",b.document.points.get("Q''")==[6.0,5.0])
	await type_name("自定义点")
	await click_mm([-6,-7])
	check("custom_chinese_name",b.document.points.get("自定义点")==[-6.0,-7.0])
	await type_name("P")
	await click_mm([-7,4])
	check("same_name_moves_only_point",b.document.points.size()==3 and b.document.points.get("P")==[-7.0,4.0])
	await button(b.tools.select)
	await click_mm([-7,4])
	await type_name("R",true)
	check("rename_existing_point",not b.document.points.has("P") and b.document.points.get("R")==[-7.0,4.0])
	await button(b.tools.undo)
	check("rename_undo",b.document.points.has("P") and not b.document.points.has("R"))
	await button(b.tools.redo)
	check("rename_redo",b.document.points.has("R") and not b.document.points.has("P"))
	await click_mm([-7,4])
	await type_name("Q''",true)
	check("duplicate_rename_preserves_both",b.document.points.size()==3 and b.document.points.has("R") and b.name_error.visible)
	await type_name("R",true)
	await button(b.tools.line)
	await click_mm([-10,-10])
	await click_mm([-5,-10])
	var second_id: String = b.document.lines[1].id
	await click_mm([-3,-1])
	c.mouse_button(b.view,local_mm([-3,-1]),MOUSE_BUTTON_RIGHT,true)
	c.mouse_button(b.view,local_mm([-3,-1]),MOUSE_BUTTON_RIGHT,false)
	await h.wait_frames(3)
	check("right_single_click_still_cancel",b.pending==null and b.document.lines.size()==2)
	var original: Dictionary = b.document.duplicate(true)
	var old_view: Dictionary = b.view.get_view_state()
	var history: int = b.undo_stack.size()
	await right_box([-12,15],[12,2])
	check("box_select_point_and_line",b.selection.size()==3 and b.current_selection().any(func(item): return item.kind=="line" and item.id==first_id))
	check("box_excludes_outside_geometry",not b.current_selection().any(func(item): return item.id==second_id or item.id=="自定义点"))
	check("box_does_not_pan_or_edit",b.document==original and b.view.get_view_state()==old_view and b.undo_stack.size()==history)
	await snapshot("tools-multiple-selection")
	await button(b.tools.select)
	check("select_tool_preserves_group",b.selection.size()==3)
	await c.drag(b.view,local_mm([-10,12]),local_mm([-9,13]))
	check("box_selected_endpoint_can_drag",b.find_line(first_id).a==[-9.0,13.0] and b.document.points==original.points and b.find_line(second_id)==original.lines[1])
	await button(b.tools.undo)
	check("group_endpoint_drag_undo",b.document==original)
	await right_box([-12,15],[12,2])
	await button(b.tools.delete)
	check("batch_delete",b.document.lines.size()==1 and b.document.points.size()==1 and b.document.points.has("自定义点"))
	check("batch_delete_one_undo",b.undo_stack.size()==history+1)
	await button(b.tools.undo)
	check("batch_undo",b.document==original)
	await button(b.tools.redo)
	check("batch_redo",b.document.lines.size()==1 and b.document.points.size()==1)
	await button(b.tools.undo)
	await right_box([12,2],[-12,15])
	check("reverse_box_same_selection",b.selection.size()==3)
	await right_box([-1,11],[1,13])
	check("crossing_line_selected",b.selection.size()==1 and b.selection[0].id==first_id)
	await right_box([18,18],[23,22])
	check("empty_box_clears_selection",b.selection.is_empty() and b.tools.delete.disabled)
	await right_box([-12,15],[12,2],true)
	check("right_return_not_click_or_panning",b.selection.is_empty() and b.pending==null and b.view.get_view_state()==old_view)
	await right_box([-12,15],[12,2],false,true)
	check("box_zoom_continuity",b.selection.size()==3 and b.document==original and not b.view.right_holding and b.marquee==null)
	await button(b.tools.point)
	for p in [[-10,12],[10,12],[-10,-12],[10,-12],[0,0],[0,8],[8,0]]:
		await hover_mm(p)
		m = b.canvas.last_measure_geometry
		check("cursor_quadrant_"+str(p),m.point==[float(p[0]),float(p[1])] and m.x_mm==absf(p[0]) and m.y_mm==absf(p[1]))
	await snapshot("tools-axis-zero")
	var pivot: Vector2 = b.view.size*0.5
	await c.wheel(b.view,pivot,true,4)
	await hover_mm([-5,6])
	check("zoom_keeps_millimeters",b.cursor==[-5.0,6.0] and b.canvas.last_measure_geometry.x_mm==5 and b.canvas.last_measure_geometry.y_mm==6)
	await c.wheel(b.view,pivot,false,4)
	await hover_mm([-10,12])
	await snapshot("tools-braces-normal")
	DisplayServer.window_set_size(Vector2i(1060,720))
	await h.wait_frames(15)
	await hover_mm([-5,6])
	check("minimum_window_hover_correct",b.cursor==[-5.0,6.0])
	await snapshot("tools-minimum-window")
	DisplayServer.window_set_size(Vector2i(1440,900))
	await h.wait_frames(15)
	# Selection and names survive a demonstration; hidden text fields are disabled too.
	await button(b.tools.select)
	await right_box([-12,15],[12,2])
	var selected_group: Array = b.selection.duplicate(true)
	await button(r.practice_shell.find_child("Teaching",true,false))
	check("name_input_disabled_in_demo",not b.name_field.editable and r.points_demo.active)
	await button(r.points_demo.leave)
	check("selection_preserved_after_demo",b.selection==selected_group and b.document==original and b.name_field.editable)
	await button(b.tools.line)
	await click_mm([2,2])
	await button(r.practice_shell.find_child("Mode_observe",true,false))
	check("mode_transition_cancels_pending",b.pending==null and b.marquee==null and not b.view.right_holding)
	await button(r.free_shell.find_child("Mode_practice",true,false))
	b.save_draft()
	FileAccess.open("res://qa/practice-tools-expected.json",FileAccess.WRITE).store_string(JSON.stringify({"document":b.document}))
	finish("practice-tools-check.json")
